rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin(){ return request.auth != null && request.auth.token.email in ['lifecasts.h@gmail.com']; }
    function member(){ return request.auth != null && (admin() ||
      request.auth.token.email in firestore.get(/databases/(default)/documents/cloudcfg/config).data.users); }
    match /cloud/lc/{file=**} { allow read, write: if admin(); }
    match /cloud/{sp}/{file=**} { allow read, write: if sp == 'u_' + request.auth.uid && member()
      && (request.resource == null || request.resource.size < 2 * 1024 * 1024 * 1024); }
  }
}
